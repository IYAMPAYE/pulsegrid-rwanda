    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "YOUR_GEMINI_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are an assistant that scores the urgency of electricity outage reports for a utility company in Rwanda. Customers may describe their situation in Kinyarwanda, French, or English \\u2014 understand the description regardless of which language it's written in. Read the customer's description and respond with ONLY a JSON object (no markdown, no extra text) in this exact format, with the values themselves always in English: {\\\"urgency\\\": \\\"Low\\\" or \\\"Medium\\\" or \\\"High\\\", \\\"safety_flag\\\": \\\"Yes\\\" or \\\"No\\\", \\\"reason\\\": \\\"one short sentence explaining why, written in English\\\"}. Mark safety_flag as Yes if there is any mention of fire, sparks, smoke, electric shock, or immediate danger. Treat vulnerable circumstances (young children, elderly residents, medical equipment, newborns) as raising urgency even without explicit danger words. Customer's description: \\\"{{ JSON.stringify($json.description).slice(1, -1) }}\\\". Region: {{ $json.region }}. Time window: {{ $json.time_window }}.\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"response_mime_type\": \"application/json\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        288,
        0
      ],
      "id": "1fd55796-bd5d-4690-a305-45f229f1b3b3",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "// PulseGrid â€” urgency scoring\n// Primary: read Gemini's real assessment from the HTTP Request node.\n// Fallback: free keyword scoring, used only if Gemini's response\n// is missing or can't be parsed (API hiccup, rate limit, etc.)\n\n// The Gemini response is the current item.\n// The original ticket fields (ticket_id, name, etc.) live on the\n// \"Edit Fields\" node's output, which we fetch by name â€” it no\n// longer flows through automatically once HTTP Request replaces it.\nconst geminiResponse = $input.first().json;\nconst item = $('Edit Fields').first().json;\n\nlet urgency = null;\nlet safetyFlag = null;\nlet reason = null;\n\n// --- Try reading Gemini's answer first ---\ntry {\n  const rawText = geminiResponse.candidates[0].content.parts[0].text;\n  const parsed = JSON.parse(rawText);\n\n  if (parsed.urgency && parsed.safety_flag) {\n    urgency = parsed.urgency;\n    safetyFlag = parsed.safety_flag;\n    reason = parsed.reason || \"Scored by AI\";\n  }\n} catch (e) {\n  // Gemini response missing or malformed â€” fall through to keywords\n}\n\n// --- Fallback: free keyword scoring ---\nif (!urgency) {\n  const text = (item.description || \"\").toLowerCase();\n\n  const emergencyWords = [\"spark\", \"sparks\", \"sparking\", \"smoke\", \"burning\",\n    \"fire\", \"shock\", \"shocked\", \"explode\", \"explosion\", \"smell of burning\"];\n\n  const distressWords = [\"scared\", \"terrified\", \"emergency\", \"urgent\",\n    \"dangerous\", \"please help\", \"worried\", \"afraid\"];\n\n  const minorWords = [\"flicker\", \"flickering\", \"sometimes\", \"occasionally\",\n    \"minor\", \"small\", \"slight\", \"dim\"];\n\n  let matched = [];\n  let flagged = false;\n\n  for (const w of emergencyWords) {\n    if (text.includes(w)) { flagged = true; matched.push(w); }\n  }\n  for (const w of distressWords) {\n    if (text.includes(w)) { matched.push(w); }\n  }\n\n  if (flagged || distressWords.some(w => text.includes(w))) {\n    urgency = \"High\";\n  } else if (minorWords.some(w => text.includes(w)) && text.length < 200) {\n    urgency = \"Low\";\n  } else {\n    urgency = \"Medium\";\n  }\n\n  safetyFlag = flagged ? \"Yes\" : \"No\";\n  reason = matched.length\n    ? \"Fallback keyword match: \" + matched.join(\", \")\n    : \"Fallback: no strong signals detected\";\n}\n\n// --- Build the final ticket, dropping the huge Gemini response object ---\nreturn {\n  json: {\n    ticket_id: item.ticket_id,\n    issue_type: item.issue_type,\n    status: item.status,\n    created_at: item.created_at,\n    time_window: item.time_window,\n    email: item.email,\n    phone: item.phone,\n    name: item.name,\n    region: item.region,\n    description: item.description,\n    urgency: urgency,\n    safety_flag: safetyFlag,\n    urgency_reason: reason\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "e4c04878-814e-4f11-bf53-6ec82d649bee",
      "name": "Urgency Scoring"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// PulseGrid — outage clustering + technician routing (DB-first)\n\nconst currentTicket = $('Urgency Scoring').first().json;\nconst matchingRows = $('Get Recent Tickets').all().map(i => i.json);\n\nconst CLUSTER_WINDOW_HOURS = 3;\nconst CLUSTER_THRESHOLD = 2;\n\nconst cutoff = Date.now() - CLUSTER_WINDOW_HOURS * 60 * 60 * 1000;\n\nconst recentSameRegion = matchingRows.filter(r => {\n  const t = new Date(r.created_at).getTime();\n  return !isNaN(t) && t > cutoff && r.status !== \"Resolved\";\n});\n\nconst clusterAlert = recentSameRegion.length >= CLUSTER_THRESHOLD ? \"Yes\" : \"No\";\nconst clusterCount = recentSameRegion.length + 1;\n\nlet urgency = currentTicket.urgency;\nlet urgencyReason = currentTicket.urgency_reason;\n\nif (clusterAlert === \"Yes\" && urgency !== \"High\") {\n  urgencyReason =\n    \"Escalated to High: \" + clusterCount + \" reports from \" +\n    currentTicket.region + \" in the last \" + CLUSTER_WINDOW_HOURS +\n    \" hours. Original assessment: \" + urgencyReason;\n  urgency = \"High\";\n}\n\nconst lookupRows = $('Lookup Technician by Region').all().map(i => i.json);\nconst dbMatch = lookupRows.find(r => r && r.technician && r.technician_email);\n\nconst fallbackMap = {\n  kigali:    { name: \"J. Mugisha\",   email: \"ribertiyampaye@gmail.com\" },\n  rubavu:    { name: \"B. Jamvier\",   email: \"thechribert@gmail.com\" },\n  nyagatare: { name: \"A. Uwase\",     email: \"mutabazievariste250@gmail.com\" },\n  musanze:   { name: \"P. Niyonzima\", email: \"mbihayimanabonard@gmail.com\" },\n  huye:      { name: \"C. Ange\",      email: \"muyangopelagie5@gmail.com\" }\n};\n\nlet technician, technicianEmail;\n\nif (dbMatch) {\n  technician = dbMatch.technician;\n  technicianEmail = dbMatch.technician_email;\n} else {\n  const regionKey = (currentTicket.region || \"\").toLowerCase().trim();\n  const fb = fallbackMap[regionKey];\n  technician = fb ? fb.name : \"Unassigned\";\n  technicianEmail = fb ? fb.email : \"ribertiyampaye@gmail.com\";\n}\n\nreturn [{\n  json: {\n    ...currentTicket,\n    urgency: urgency,\n    urgency_reason: urgencyReason,\n    technician: technician,\n    technician_email: technicianEmail,\n    cluster_alert: clusterAlert,\n    cluster_count: clusterCount\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        0
      ],
      "id": "97ce2eab-ed94-4ff2-9824-6e44be4d4238",
      "name": "Clustering And Routing"
    },
